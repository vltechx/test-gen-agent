# Copy to .env.local (gitignored) and adjust. Vite reads it when `npm run dev` starts.

# Base URL of the Part Analyzer API, without /analyze.
# Local: cd ../part-analyzer-api && uvicorn app.main:app --reload
# Deployed: the ApiUrl output printed by `sam deploy`.
VITE_PART_ANALYZER_URL=http://127.0.0.1:8000
